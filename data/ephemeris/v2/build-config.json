{
  "datasetVersion": "2.0.0",
  "formatVersion": "1.0.0",
  "chunkSchema": "ephemeris.chunk.v1",
  "encoder": "json-base64",
  "streams": {
    "primary": {
      "hotWindowYears": 40,
      "maxUncompressedBytesPerChunk": 2500000,
      "maxEncodedBytesPerChunk": 3500000,
      "includeTargetKeys": [
        "sun",
        "mercury",
        "venus",
        "earth",
        "mars",
        "jupiter",
        "saturn",
        "uranus",
        "neptune",
        "pluto",
        "moon"
      ]
    },
    "auxiliary": {
      "hotWindowYears": 20,
      "maxUncompressedBytesPerChunk": 3500000,
      "maxEncodedBytesPerChunk": 5000000,
      "includeTargetKeys": []
    }
  },
  "formats": {
    "json-base64": {
      "contentType": "application/json",
      "compression": "none",
      "vectorEncoding": "float32-base64"
    }
  },
  "bodyRenderDefaults": {
    "primary": {
      "renderClass": "primary",
      "hasLabel": true,
      "hasTrail": true
    },
    "featuredAuxiliary": {
      "renderClass": "featuredAuxiliary",
      "hasLabel": true,
      "hasTrail": true
    },
    "beltSample": {
      "renderClass": "beltSample",
      "hasLabel": false,
      "hasTrail": false
    }
  }
}
